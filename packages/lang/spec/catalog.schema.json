{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigil-native.dev/catalog.schema.json",
  "title": "Sigil component catalog",
  "description": "Single source of truth for catalog validation, prompt generation, and renderer conformance.",
  "type": "object",
  "required": ["version", "components"],
  "properties": {
    "version": { "type": "integer" },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["props"],
        "properties": {
          "description": { "type": "string" },
          "children": { "type": "string", "enum": ["none", "inline", "any"] },
          "props": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
                },
                "token": { "type": "string", "enum": ["spacing", "radius", "fontSize", "raw"] },
                "event": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
